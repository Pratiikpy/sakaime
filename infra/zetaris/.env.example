# Entries the Sakaime Zetaris scripts read from the repository .env (gitignored). Placeholders only.
# `node infra/zetaris/scripts/secrets.mjs` generates every SAKAIME_* entry below that is missing; the three registry
# entries come from your Zetaris Cloud account (Run locally page) and cannot be generated.

# Zetaris image registry login, shown on the "Run locally" page after you register at https://cloud.enterprise.zetaris.com/register
ZETARIS_REGISTRY=<registry host from the download page>
ZETARIS_REGISTRY_USER=<registry user from the download page>
ZETARIS_REGISTRY_PASSWORD=<registry password from the download page>

# Generated. Metastore database password: letters and digits only, it is embedded in JDBC URLs.
SAKAIME_ZETARIS_PG_PASSWORD=<generated>
# Generated. Administrator of the Zetaris organisation (account name is ZETARIS_ADMIN_EMAIL in sakaime.env).
# Zetaris requires at least 8 characters with a lower case letter, an upper case letter, a digit and one of $ @ ! % * ? &
SAKAIME_ZETARIS_ADMIN_PASSWORD=<generated>
# Generated. Password of the synthetic hospital Postgres database.
SAKAIME_HOSPITAL_PG_PASSWORD=<generated>

# Generated. The three non-admin identities created by seed.mjs.
SAKAIME_ZETARIS_READER_EMAIL=agent-reader@sakaime.example
SAKAIME_ZETARIS_READER_PASSWORD=<generated>
SAKAIME_ZETARIS_REVIEWER_EMAIL=reviewer-unassigned@sakaime.example
SAKAIME_ZETARIS_REVIEWER_PASSWORD=<generated>
SAKAIME_ZETARIS_ASSIGNED_EMAIL=reviewer-assigned@sakaime.example
SAKAIME_ZETARIS_ASSIGNED_PASSWORD=<generated>
