# Non-secret configuration for the Sakaime Zetaris stack. Read by scripts/up.sh together with the secrets file it
# generates from the repository .env. Variable names are the ones the vendor compose file reads.

# Compose project. Container, network and volume names are prefixed with it, so the stack cannot collide with any
# other Zetaris installation on the same Docker engine.
COMPOSE_PROJECT_NAME=sakaime-zetaris

# Image tags of the Zetaris release this repository was verified against (2.4.3.1, hackathon build).
DRIVER_IMAGE=zetarishackathon.azurecr.io/zetaris-ndp-driver:2.4.3-v2.4.3.1-hackathon.cb88df0b255aba5a9a9eda96483fc877cc82df80
API_IMAGE=zetarishackathon.azurecr.io/zetaris-ndp-api:2.4.3-v2.4.3.1-hackathon.a2848d8a41fa21673a0d719deb41b675412710fe
UI_IMAGE=zetarishackathon.azurecr.io/zetaris-new-ui:2.4.3-v2.4.3.1-hackathon.88e49b0db015979a2d071d2d68a6865d38a39f15

# Host ports. All bound to 127.0.0.1 by the vendor compose file. They differ from the vendor defaults
# (3000, 8888, 8889, 10000, 4040) so a second Zetaris install can run beside this one.
UI_PORT=3300
API_PORT=8988
API_INTERNAL_PORT=8989
DRIVER_PORT=10100
SPARK_UI_PORT=4140
ALLOWED_ORIGINS=http://localhost:3300
GUI_URL=http://localhost:3300

# Organisation created on first start.
ZETARIS_ADMIN_EMAIL=admin@sakaime.example
ZETARIS_ADMIN_ORG=sakaime

# Sizing. The vendor laptop profile is 2g driver heap and 1g API heap and needs roughly 8 GB for Docker. The
# development machine this was first verified on gave Docker 3.9 GB, so the heaps are smaller; raise them on a larger
# host (see README, Sizing). Spark runs in local mode inside the driver container.
ZSPARK_DRIVER_MEM=1536m
ZSPARK_DRIVER_CORES=2
ZSPARK_MASTER_URL=local[2]
ZETARIS_API_MAX_HEAP=768m
POSTGRES_SHARED_BUFFERS=96MB
POSTGRES_EFFECTIVE_CACHE=512MB
POSTGRES_WORK_MEM=8MB

# Usage reporting: left at the vendor default (the platform asks once, in the UI, and sends nothing until answered).
TELEMETRY_ENABLED=

# Silo containers added by docker-compose.sakaime.yml.
SAKAIME_HOSPITAL_PG_USER=sakaime
SAKAIME_HOSPITAL_PG_PORT=15433
SAKAIME_S3_PORT=19190
SAKAIME_REST_SILO_PORT=18080
