{"protocolSection":{"identificationModule":{"nctId":"NCT03897140","orgStudyIdInfo":{"id":"EchoGPSPivotal1.0"},"organization":{"fullName":"Caption Health, Inc.","class":"INDUSTRY"},"briefTitle":"Point-of-Care Echocardiography With Assistance Technology","officialTitle":"Study for Point-of-Care Echocardiography With Assistance Technology"},"statusModule":{"statusVerifiedDate":"2019-09","overallStatus":"COMPLETED","expandedAccessInfo":{"hasExpandedAccess":false},"startDateStruct":{"date":"2019-03-25","type":"ACTUAL"},"primaryCompletionDateStruct":{"date":"2019-05-23","type":"ACTUAL"},"completionDateStruct":{"date":"2019-05-23","type":"ACTUAL"},"studyFirstSubmitDate":"2019-03-23","studyFirstSubmitQcDate":"2019-03-28","studyFirstPostDateStruct":{"date":"2019-04-01","type":"ACTUAL"},"lastUpdateSubmitDate":"2019-09-13","lastUpdatePostDateStruct":{"date":"2019-09-17","type":"ACTUAL"}},"sponsorCollaboratorsModule":{"responsibleParty":{"type":"SPONSOR_INVESTIGATOR","investigatorFullName":"Sara Guttas","investigatorTitle":"Clinical Applications Manager","investigatorAffiliation":"Caption Health, Inc."},"leadSponsor":{"name":"Sara Guttas","class":"INDUSTRY"}},"oversightModule":{"oversightHasDmc":false,"isFdaRegulatedDrug":false,"isFdaRegulatedDevice":true,"isUnapprovedDevice":true,"isUsExport":false},"descriptionModule":{"briefSummary":"Establish the effectiveness of the Bay Labs, Inc. EchoGPS software in enabling RNs to acquire echocardiograms. In this study an echocardiogram protocol using the EchoGPS interface with the Terason uSmart 3200t, an FDA 510(k)-cleared, commercially available ultrasound device will be performed. Participants will have two scans, one by a registered nurse (RN) using the Terason uSmart 3200t with EchoGPS (Study Exam) and one by a sonographer using the Reference Device without EchoGPS guidance (Control Exam), under the same protocol. Study is non-significant risk (NSR).","detailedDescription":"To validate clinical use of Bay Labs, Inc. EchoGPS guidance software by registered nurses (RNs) with no prior scanning experience to acquire limited two-dimensional echocardiograms. In this study an echocardiogram protocol using the EchoGPS interface with the Terason uSmart 3200t, an FDA 510(k)-cleared, commercially available ultrasound device will be performed. Participants will have two scans, one by a registered nurse (RN) using the Terason uSmart 3200t with EchoGPS (Study Exam) and one by a sonographer using the Reference Device without EchoGPS guidance (Control Exam), under the same protocol. Study is non-significant risk (NSR)."},"conditionsModule":{"conditions":["Cardiac Disease"]},"designModule":{"studyType":"INTERVENTIONAL","phases":["NA"],"designInfo":{"allocation":"NA","interventionModel":"SINGLE_GROUP","primaryPurpose":"DIAGNOSTIC","maskingInfo":{"masking":"NONE"}},"enrollmentInfo":{"count":240,"type":"ACTUAL"}},"armsInterventionsModule":{"armGroups":[{"label":"Patients scheduled for an echocardiogram","type":"EXPERIMENTAL","description":"Patients ≥18 years scheduled for an echocardiographic examination. This is a non-randomized, un-blinded, study in patients with an indication for an echocardiographic examination. Enrolled patients will be stratified into two groups based on known cardiac abnormalities to ensure a sufficient number of patients with cardiac abnormalities and into 3 strata of BMI: normal, overweight and obese.","interventionNames":["Diagnostic Test: Diagnostic Test: Limited Echocardiogram"]}],"interventions":[{"type":"DIAGNOSTIC_TEST","name":"Diagnostic Test: Limited Echocardiogram","description":"STUDY SOFTWARE non-significant risk (NSR) Bay Labs EchoGPS software interfaced with the Terason uSmart 3200t FDA 510(k)-cleared, commercially available ultrasound EchoGPS software communicates with the ultrasound image formation engine of the 510(k)-cleared Terason uSmart 3200t through an application programming interface (API). EchoGPS will be used to provide visual guidance feedback to users during image acquisition. For this study, RNs will use EchoGPS to perform limited echocardiogram examinations.","armGroupLabels":["Patients scheduled for an echocardiogram"]}]},"outcomesModule":{"primaryOutcomes":[{"measure":"Study-level Assessment","description":"The primary endpoints for the study are separate patient-level assessments of whether the patient study is of adequate image quality to make a qualitative visual assessment for a particular clinical parameter (ie., Yes/No). Expert cardiologist readers will independently provide assessments and they will be blinded to the assessments from the other readers as well as whether the images were acquired by an RN or sonographer.\n\nThe Outcome Measure will be reported as the percentage of patient studies for which the panel of cardiologist readers adjudicated as being of sufficient image quality to make a particular clinical assessment.","timeFrame":"Up to 2 months from the completion of the study or when all expert cardiologists readers independently complete their assessments"}],"secondaryOutcomes":[{"measure":"View-level Assessment","description":"The Outcome Measure will be reported as the percentage of patient studies with diagnostic quality clip for a particular Standard View acquired in the study. Expert cardiologist readers will independently provide assessments and they will be blinded to the assessments from the other readers as well as whether the images were acquired by an RN or sonographer.","timeFrame":"Up to 2 months from the completion of the study or when all expert cardiologists readers independently complete their assessments"},{"measure":"Inter-User Variability (Primary Clinical Parameters)","description":"o Comparison of user variability for primary clinical parameters (measured as the coefficient variation for binary assessment of whether the study is of diagnostic quality to make a particular clinical assessment)","timeFrame":"Up to 2 months from the completion of the study or when all expert cardiologists readers independently complete their assessments"},{"measure":"Inter-User Variability (Acquisition Time)","description":"o View level acquisition time (minutes and seconds)","timeFrame":"Up to 2 months from the completion of the study or when all expert cardiologists readers independently complete their assessments"},{"measure":"Patient-Level Acquisition time","description":"o Patient level acquisition time (minutes and seconds)","timeFrame":"Up to 2 months from the completion of the study or when all expert cardiologists readers independently complete their assessments"},{"measure":"View-Level Acquisition time","description":"o View-level acquisition time (minutes and seconds)","timeFrame":"Up to 2 months from the completion of the study or when all expert cardiologists readers independently complete their assessments"},{"measure":"Comparison of study exam and control exam (View-Level Results)","description":"o Comparison of View level results measured as percent agreement of images with diagnostic quality","timeFrame":"Up to 2 months from the completion of the study or when all expert cardiologists readers independently complete their assessments"},{"measure":"Comparison of study exam and control exam (Patient-Level Results)","description":"o Comparison of patient level results measured as percent agreement of patient exams of sufficient quality to make a particular clinical assessment","timeFrame":"Up to 2 months from the completion of the study or when all expert cardiologists readers independently complete their assessments"},{"measure":"Comparison of study exam and control exam (Task-Based Assessment)","description":"o Comparison of qualitative assessments from study and control exam to assess whether cardiologists reach a similar decision with study exam images and control exam images","timeFrame":"Up to 2 months from the completion of the study or when all expert cardiologists readers independently complete their assessments"}]},"eligibilityModule"