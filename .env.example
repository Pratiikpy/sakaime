# Copy to .env and fill in. Never commit .env.
#
# SAMPLE_MODE needs none of this. With SAMPLE_MODE=true every external read is replayed from the recordings in the repository
# and `npm run judge` runs on a clean clone with no keys.

# --- Run mode ---------------------------------------------------------------
# true: replay recorded sources, recorded Zetaris statements and recorded model replies. Nothing leaves the machine.
SAMPLE_MODE=true
# Set to 1 only when recording new cassettes with scripts/record-sample.ts.
SAKAIME_RECORD=

# --- HTTP service -----------------------------------------------------------
# The service binds to loopback by default and answers only requests addressed to localhost.
HOST=127.0.0.1
PORT=8787
# The one browser origin allowed to call the API (the web app dev server).
SAKAIME_UI_ORIGIN=http://localhost:5173
# Where the live service keeps its decision logs and traces. Defaults to .sakaime/state.
SAKAIME_STATE_DIR=

# --- Model route (NVIDIA Nemotron) ------------------------------------------
# Either the Nightshift gateway (preferred, adds receipts) ...
NIGHTSHIFT_BASE_URL=
NIGHTSHIFT_API_KEY=
NIGHTSHIFT_APP_ID=
NIGHTSHIFT_RECEIPT_KEY_ID=
# ... or NVIDIA's free API directly.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Any OpenAI-compatible endpoint can stand in for either.
MODEL_BASE_URL=
MODEL_API_KEY=
# Optional JSON map of role to model id, for example {"critic":"nvidia/nemotron-ultra"}.
SAKAIME_ROLE_MODELS=

# --- Zetaris (federation engine) --------------------------------------------
ZETARIS_REST_URL=http://127.0.0.1:8988
ZETARIS_ORG_ID=
# The service signs in as a read-only user and uses the session token it is given.
SAKAIME_ZETARIS_READER_EMAIL=
SAKAIME_ZETARIS_READER_PASSWORD=
# Only the setup scripts under infra/ use these; the service never does.
ZETARIS_ADMIN_EMAIL=
SAKAIME_ZETARIS_ADMIN_PASSWORD=
ZETARIS_API_KEY=

# --- Object store for the silo documents ------------------------------------
SAKAIME_OBJECT_STORE_URL=

# --- Dossier signing --------------------------------------------------------
# Leave empty to sign with the published demo key (the verifier labels it "demo").
# A real deployment points this at a key file kept outside the repository and pins its public key.
SAKAIME_DOSSIER_KEY_FILE=
