    "csv-parse": "^7.0.3",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.14",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "yaml": "^2.9.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
